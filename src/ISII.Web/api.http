@MinimalClean_HostAddress = http://localhost:57379

@MinimalClean_CartId = 68fe4cfd-84bb-4b8a-bb4e-528c26325c72

### List Products
GET {{MinimalClean_HostAddress}}/products
Accept: application/json

### Get Product By ID
GET {{MinimalClean_HostAddress}}/products/1
Accept: application/json

### Create Product
POST {{MinimalClean_HostAddress}}/products
Content-Type: application/json

{
  "name": "New Product",
  "unitPrice": 29.99
}

### Asignar Categoria a un Producto (200 OK)
PUT {{MinimalClean_HostAddress}}/products/1/categoria
Content-Type: application/json

{
  "categoriaId": 1
}

### Asignar Categoria a un Producto inexistente (404 Not Found)
PUT {{MinimalClean_HostAddress}}/products/9999/categoria
Content-Type: application/json

{
  "categoriaId": 1
}

### Asignar Categoria inexistente a un Producto (404 Not Found)
PUT {{MinimalClean_HostAddress}}/products/1/categoria
Content-Type: application/json

{
  "categoriaId": 9999
}

### Crear Categoria (201 Created)
POST {{MinimalClean_HostAddress}}/categorias
Content-Type: application/json

{
  "nombre": "Bebidas",
  "descripcion": "Gaseosas, jugos y aguas"
}

### Crear Categoria con nombre repetido (409 Conflict)
POST {{MinimalClean_HostAddress}}/categorias
Content-Type: application/json

{
  "nombre": "bebidas"
}

### Crear Categoria sin nombre (400 Bad Request)
POST {{MinimalClean_HostAddress}}/categorias
Content-Type: application/json

{
  "nombre": ""
}

### Obtener Categoria por Id (200 OK)
GET {{MinimalClean_HostAddress}}/categorias/1
Accept: application/json

### Obtener Categoria inexistente (404 Not Found)
GET {{MinimalClean_HostAddress}}/categorias/9999
Accept: application/json

### Obtener Categoria con Id invalido (400 Bad Request)
GET {{MinimalClean_HostAddress}}/categorias/0
Accept: application/json

### Add to Cart (Anonymous User - creates cart)
POST {{MinimalClean_HostAddress}}/cart
Content-Type: application/json

{
  "productId": 1,
  "quantity": 2
}

### Add to Cart (Anonymous User - existing cart)
POST {{MinimalClean_HostAddress}}/cart
Content-Type: application/json

{
  "cartId": "{{MinimalClean_CartId}}",
  "productId": 2,
  "quantity": 3
}

### View Cart
GET {{MinimalClean_HostAddress}}/cart/{{MinimalClean_CartId}}
Accept: application/json

### Checkout
POST {{MinimalClean_HostAddress}}/cart/{{MinimalClean_CartId}}/checkout
Content-Type: application/json

{
  "email": "guest@example.com"
}
### Note: Get order ID from response for future use




